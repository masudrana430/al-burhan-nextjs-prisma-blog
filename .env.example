# Copy these values to your local .env.local for development.
# On Vercel, add them in Project Settings -> Environment Variables.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console -> OAuth client -> Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI:
# https://al-burhan-pearl-nine.vercel.app/api/auth/callback/google

# AI providers (server-side only; never prefix keys with NEXT_PUBLIC_)
# Free-first order: OpenRouter free router -> Gemini -> optional Groq free tier
AI_PROVIDER_ORDER=openrouter,gemini,groq
AI_FREE_MODE=true
OPENROUTER_API_KEY=
# Routes to an available free OpenRouter chat model; free quota is rate limited.
OPENROUTER_MODEL=openrouter/free

GEMINI_API_KEY=
# Primary Gemini model and fallback when the primary model is overloaded.
AI_MODEL=gemini-3.8-flash
AI_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Set true only after confirming this Groq account is still on its Free tier.
# Groq Developer-tier model calls are usage-billed.
AI_GROQ_FREE_TIER_CONFIRMED=false

# Per-provider request timeout in milliseconds (the route also enforces a total budget).
AI_PROVIDER_TIMEOUT_MS=10000

# Set true only after stored Post embeddings are rebuilt with gemini-embedding-001 (768 dimensions).
AI_VECTOR_INDEX_READY=false
